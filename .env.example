# === 数据库（必需）===
# Supabase PostgreSQL 连接字符串
# 在 Supabase 控制台 → Project Settings → Database → Connection string → URI
# 格式: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# === Fish Audio TTS 配置 ===
FISH_AUDIO_API_KEY=
# 男声模型 ID（低沉男声，可通过 Fish Audio 声音克隆获取）
FISH_AUDIO_MALE_VOICE_ID=ef9c79b62ef34530bf452c0e50e3c260
# S2-Pro 情感标签（自然语言，bracket 语法）
FISH_AUDIO_STYLE_HINT=gentle, warm, soft
# 默认语速 0.5-2.0
FISH_AUDIO_SPEED=0.9

# === 其他 API 密钥（可选）===
APP_ID=
APP_SECRET=
KIMI_API_KEY=
WEATHER_API_KEY=
MIMO_API_KEY=

# === Node 环境 ===
NODE_ENV=production
PORT=3000

# === 迁移控制 ===
# 设为 1 跳过自动迁移（Supabase 已通过 db:push 管理 schema，通常不需要此选项）
SKIP_AUTO_MIGRATE=0

# === 定时同步（P0 新增）===
# cron 间隔（分钟），默认 30，设为 0 禁用
SYNC_CRON_INTERVAL=30
